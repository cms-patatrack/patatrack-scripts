#! /usr/bin/env python3

import sys
import os

# check that CMSSW_BASE is set
if not 'CMSSW_BASE' in os.environ:
    sys.stderr.write('Error: the CMS environment is not set up, please run "cmsenv" or "eval `scram runtime -sh`".\n')
    sys.exit(1)

# local packages
import multirun
from common import *
from options import OptionParser, printCommonArgs
from multirun import *

def parseArguments():
  parser = OptionParser()

  # Change the default to use a CSV file
  csv = parser.parser._actions[[ action.dest for action in parser.parser._actions ].index('csv')]
  csv.default = 'scan.csv'
  csv.help = csv.help.replace('None', 'scan.csv')

  # Options specific to scan
  parser.parser.add_argument('--steps',
    type = int,
    nargs = '+',
    default = None,
    help = 'list, or None to make a linear scan from min_step to max_step [default: None]')

  parser.parser.add_argument('--min-step',
    dest = 'min_step',
    type = int,
    default = 1,
    help = 'minimum number of cores to scan [default: 1]')

  parser.parser.add_argument('--max-step',
    dest = 'max_step',
    type = int,
    default = None,
    help = 'maximum number of cores to scan. Use None to guess based on the number of available cores (or threads) and concurrent jobs [default: None]')

  parser.parser.add_argument('--events-extra-per-thread',
    dest = 'events_extra_per_thread',
    default = 0,
    type = int,
    help = 'increase by this amount the number of events per thread [default: 0]')

  parser.parser.add_argument('--events-limit',
    dest = 'events_limit',
    type = int,
    default = 0,
    help = 'if not 0, limit the total number of events to be processed [default: 0]')

  return parser.parse(sys.argv[1:])


def printJobInfo(opts, steps):
  print("""
Selected Configuration:
  - config:          {}
  - steps:           {}
  - input benchmark: {}
  - csv file:        {}
  - logdir:          {}
  - events_limit:    {}
  - jobs:            {}
  - repeat:          {}
  - threads:         {}
  - streams:         {}
""".format(opts.configs[0],
           steps,
           opts.input_benchmark,
           opts.csv,
           opts.logdir,
           opts.events_limit,
           opts.jobs,
           opts.repeats,
           opts.threads,
           opts.streams))


if __name__ == "__main__":
  opts = parseArguments()

  # scan sweeps a single configuration over a range of thread counts; the shared parser accepts
  # several configs (for benchmark's matrix), so reject the extra ones here rather than silently
  # ignoring all but the first
  if len(opts.configs) > 1:
    sys.stderr.write('%s: error: scan operates on a single configuration, but %d were given: %s\n'
                     % (sys.argv[0], len(opts.configs), ' '.join(opts.configs)))
    sys.exit(1)

  # --no-nvidia-mps: never start NVIDIA MPS, and refuse to run if a control daemon is already active
  if opts.no_nvidia_mps:
    multirun.ensure_nvidia_mps_off()

  # apply --gpus; accepts a plain list ("0,1") or a per-vendor form ("nvidia=0,1:amd=0") for
  # mixed nodes
  multirun.apply_gpu_selection(opts.gpus)

  config = opts.configs[0]
  process = parseProcess(config)

  # common options for multirun; the per-step log directory is computed from the --logdir template
  # inside the loop below
  options = build_options(opts, opts.jobs, opts.threads, opts.streams,
                          logdir = None,
                          data = open(opts.csv, 'wt', buffering=1, encoding='utf-8') if opts.csv else None,
                          header = opts.csvheader)

  # print a system overview
  info()

  # check the available cpus
  cpus = get_cpu_info()
  if options['allow_hyperthreading']:
    count = sum(len(cpu.hardware_threads) for cpu in cpus.values())
  else:
    count = sum(len(cpu.physical_processors) for cpu in cpus.values())

  # use the explicit list of steps, or a linear scan
  max_step = opts.max_step
  if max_step is None:
    if options['jobs'] is None:
        max_step = count
    else:
        max_step = count // options['jobs']

  steps = opts.steps
  if not opts.steps:
    steps = list(range(opts.min_step, max_step + 1))

  if opts.input_benchmark:
    # prepare a trimmed down configuration for benchmarking only reading the input data
    collections = resolve_input_collections(config, opts.input_collections, opts.input_xml, opts.input_xml_events, opts.executable)
    io_process = make_io_process(process, collections)

  printJobInfo(opts, steps)

  # make a copy of the options to be updated during the scan
  step_opt = dict(options)

  # if --nvidia-mps was requested (and an NVIDIA GPU will be used), start the NVIDIA MPS control daemon
  # (unless already running) for the whole scan, and stop it at exit only if it was started here
  with nvidia_mps_session(multirun.use_nvidia_mps(opts.nvidia_mps, opts.gpus_per_job, opts.slots, opts.no_nvidia_mps)):
    try:

      # do not wait before the first step
      wait = False

      # the --gpus tag is constant across the scan, so compute it once; empty (dropping the optional
      # %gpus placeholder) when no GPU is in use -- no GPU on the node, -g 0, or a CPU-only config
      gputag = multirun.gpu_tag(opts.gpus) if multirun.gpu_in_use(opts.gpus_per_job, process) else ''

      for step in steps:
        # update the options for each step
        step_opt['threads'] = options['threads'] if options['threads'] is not None else step
        step_opt['streams'] = options['streams'] if options['streams'] is not None else step
        step_opt['jobs']    = options['jobs']    if options['jobs']    is not None else (count + step - 1) // step

        # the NVIDIA MPS tag depends on the step's job count (a value-less --nvidia-mps splits each
        # GPU among the jobs sharing it), so it is computed per step; empty when no NVIDIA GPU is in use
        nvidia_mpstag = multirun.nvidia_mps_tag(opts.nvidia_mps, step_opt['jobs'], opts.gpus_per_job, multirun.gpus_nv, opts.slots) \
                        if multirun.nvidia_in_use(opts.gpus_per_job, process) else ''

        # per-step log directory from the --logdir template; an empty logdir (--no-logdir or --logdir
        # '') means no logs, while no --logdir or a bare --logdir uses the default template. A separate
        # scan_<step> subdir keeps the steps apart unless the template already varies per step (via %t/%s/%j).
        if opts.logdir:
            base = expand_logdir(opts.logdir, config, step_opt['jobs'], step_opt['threads'], step_opt['streams'], opts.gpus_per_job, gputag, nvidia_mpstag)
            if not any(p in opts.logdir for p in ('%t', '%s', '%j')):
                base = base.rstrip('/') + '/scan_%d' % step
            step_opt['logdir'] = base
        else:
            step_opt['logdir'] = None

        # update the number of events to process based on the number of threads
        if opts.events_extra_per_thread > 0:
            step_opt['events'] = options['events'] + opts.events_extra_per_thread * step_opt['threads']

        if opts.events_limit > 0:
            if step_opt['events'] > opts.events_limit:
                step_opt['events'] = opts.events_limit

        # print configuration
        if opts.verbose:
          printCommonArgs(step_opt)
      
        # benchmark reading the input data; do not monitor this throwaway I/O-only run
        if opts.input_benchmark:
          print('Benchmarking only the input')
          io_options = dict(step_opt, repeats = opts.input_benchmark, logdir = None, keep = [], data = None, gpu_monitoring = GpuMonitorInfo.NONE)
          multiCmsRun(io_process, **io_options)
          print()
          # schedule a wait after the I/O benchmark
          if opts.wait > 0:
            wait = True

        # wait the required number of seconds afer the I/O benchmark and between each iteration
        if wait:
          time.sleep(opts.wait)

        # run
        multiCmsRun(process, **step_opt)
        # schedule a wait between each iteration
        if opts.wait > 0:
          wait = True
        # if the input files do not depend on the job configuration, warm up only once
        if opts.events_extra_per_thread == 0:
            step_opt['warmup'] = False

        # print the CSV header only once
        step_opt['header'] = False

    finally:
      # close the CSV file
      if options['data']:
        options['data'].close()
